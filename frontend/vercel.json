{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://yt1-w757.onrender.com/api/$1"
    },
    {
      "source": "/providers/(.*)",
      "destination": "https://yt1-w757.onrender.com/providers/$1"
    },
    {
      "source": "/health",
      "destination": "https://yt1-w757.onrender.com/health"
    },
    {
      "source": "/media/(.*)",
      "destination": "https://yt1-w757.onrender.com/media/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
