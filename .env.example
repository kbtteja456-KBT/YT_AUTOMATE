# ==============================================================================
# AI YouTube Shorts Autopilot - Environment Configuration Template
# ==============================================================================

# Database & Broker
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=youtube_autopilot
REDIS_URL=redis://localhost:6379/0

# Hard Zero-Cost Gate (Defaults to True; blocks all paid APIs)
ZERO_COST_MODE=true
PAID_PROVIDERS_ENABLED=false

# OpenRouter Free Models (e.g. meta-llama/llama-3.3-70b-instruct:free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google OAuth 2.0 (YouTube Data API v3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/auth/youtube/callback

# Stock Media Free API Keys (Pexels, Pixabay)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Security: AES-256 Token Encryption Key (REQUIRED).
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# This value must stay constant — changing it will invalidate all previously stored OAuth tokens.
ENCRYPTION_KEY=

# Schedule & Operations
TIMEZONE=Asia/Kolkata
DAILY_VIDEO_LIMIT=2

# Local Storage Paths
MEDIA_STORAGE_DIR=./media_storage
TEMP_DIR=./media_storage/temp
